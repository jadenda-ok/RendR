{
  "name": "rendr",
  "productName": "Rendr",
  "version": "1.1.0",
  "description": "Rendr — the all-in-one Roblox companion: crosshair overlay studio, real-time FPS indicator and FastFlags manager. Fully local, no accounts.",
  "main": "src/main/index.js",
  "author": "Rendr",
  "license": "MIT",
  "homepage": "https://github.com/jadenda-ok/RendR",
  "repository": {
    "type": "git",
    "url": "https://github.com/jadenda-ok/RendR"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.rendr.app",
    "productName": "Rendr",
    "copyright": "Copyright © 2026 Rendr",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/presentmon",
        "to": "presentmon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rendr",
      "artifactName": "rendr-setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jadenda-ok",
        "repo": "RendR",
        "releaseType": "release"
      }
    ]
  }
}
